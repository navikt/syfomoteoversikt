  "author": "Team DigiSyfo <digisyfo@nav.no>",
  "type": "module",
  "main": "index.tsx",
  "scripts": {
    "start": "pnpm msw:update && vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc --build ./server/tsconfig.json",
    "test": "vitest run",
    "lint-and-typecheck": "pnpm lint:check && pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:write": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "msw:update": "msw init . --save"
  },
  "dependencies": {
    "@grafana/faro-react": "1.19.0",
    "@grafana/faro-web-sdk": "1.19.0",
    "@grafana/faro-web-tracing": "1.19.0",
    "@navikt/aksel-icons": "7.33.2",
    "@navikt/ds-css": "7.33.2",
    "@navikt/ds-react": "7.33.2",
    "@navikt/pino-logger": "5.0.0",
    "@tanstack/react-query": "5.100.10",
    "@types/express": "4.17.21",
    "@types/express-http-proxy": "1.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@types/styled-components": "5.1.34",
    "axios": "1.16.1",
    "dotenv": "17.4.2",
    "express": "4.22.1",
    "express-http-proxy": "1.6.3",
    "helmet": "4.6.0",
    "http-proxy": "1.18.1",
    "https-proxy-agent": "5.0.1",
    "lodash.throttle": "4.1.1",
    "prom-client": "11.5.3",
    "react": "19.2.6",
    "react-document-title": "2.0.3",
    "react-dom": "19.2.6",
    "react-router-dom": "6.30.3",
    "styled-components": "5.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query-devtools": "5.100.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.13.1",
    "@types/react-document-title": "2.0.10",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.5.0",
    "jsdom": "26.0.0",
    "msw": "2.14.6",
    "oxfmt": "0.55.0",
