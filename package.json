{
  "name": "syfomoteoversikt",
  "version": "0.0.1",
  "description": "Digitalisering av sykefraværsoppfølging",
  "license": "ISC",
  "author": "Team DigiSyfo <digisyfo@nav.no>",
  "type": "module",
  "main": "index.tsx",
  "scripts": {
    "start": "pnpm msw:update && vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc --build ./server/tsconfig.json",
    "test": "vitest run",
    "lint-and-typecheck": "pnpm lint:check && pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:write": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "msw:update": "msw init . --save"
  },
  "dependencies": {
    "@nais/apm": "0.7.2",
    "@navikt/aksel-icons": "8.18.0",
    "@navikt/ds-css": "8.18.0",
    "@navikt/ds-react": "8.18.0",
    "@navikt/ds-tailwind": "8.18.0",
    "@navikt/pino-logger": "5.0.1",
    "@tanstack/react-query": "5.104.0",
    "@types/express": "5.0.6",
    "@types/express-http-proxy": "1.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/styled-components": "5.1.34",
    "axios": "1.20.0",
    "dotenv": "16.5.0",
    "express": "5.2.1",
    "express-http-proxy": "1.6.3",
    "helmet": "8.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "styled-components": "5.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.104.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.13.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@12.3.4",
